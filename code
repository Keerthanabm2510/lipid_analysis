    subtitle = "Mean log2FC of lipids detected in both timepoints",
    x        = "Mean log2 Fold Change (T2/T1)",
    y        = NULL
  ) +
  theme_bw(base_size = 12) +
  theme(
    strip.background = element_rect(fill = "#2b2b2b"),
    strip.text       = element_text(color = "white", face = "bold", size = 10),
    plot.title       = element_text(face = "bold")
  )
 
ggsave("KEGG_class_dotplot.png", p_dot, width = 10, height = 14, dpi = 220)
cat("✓ Saved: KEGG_class_dotplot.png\n\n")
lipid_nodes <- data_wide %>%
  transmute(
    name       = Lipid,
    level      = "Lipid",
    Class      = Class,
    log2FC     = log2FC,
    abundance  = (log2_T1 + log2_T2) / 2,
    detected   = detected_in
  )
 
class_nodes <- fc_kegg_mapped %>%
  group_by(Class) %>%
  summarise(
    log2FC    = mean(log2FC[detected_in == "Both"], na.rm = TRUE),
    abundance = mean((log2_T1 + log2_T2) / 2, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  transmute(
    name      = Class,
    level     = "Class",
    Class     = Class,
    log2FC    = log2FC,
    abundance = abundance,
    detected  = "Both"
  )
 
pathway_nodes <- pathway_summary %>%
  transmute(
    name      = KEGG_pathway,
    level     = "Pathway",
    Class     = "Pathway",
    log2FC    = mean_log2FC,
    abundance = NA_real_,
    detected  = "Both"
  )
 
all_nodes <- bind_rows(lipid_nodes, class_nodes, pathway_nodes) %>%
  distinct(name, .keep_all = TRUE)
 
# --- 4B: Build edge table ---
# Lipid → Class edges
edges_lc <- data_wide %>%
  transmute(from = Lipid, to = Class, weight = 1, edge_type = "Lipid → Class")
 
# Class → Pathway edges (weight = number of lipids in that class for that pathway)
edges_cp <- fc_kegg_mapped %>%
  count(Class, KEGG_pathway, name = "weight") %>%
  transmute(from = Class, to = KEGG_pathway, weight = weight,
            edge_type = "Class → Pathway")
 
all_edges <- bind_rows(edges_lc, edges_cp) %>%
  filter(from %in% all_nodes$name, to %in% all_nodes$name)
 
# --- 4C: igraph object ---
g <- graph_from_data_frame(all_edges, vertices = all_nodes, directed = TRUE)
 
V(g)$level     <- all_nodes$level[match(V(g)$name, all_nodes$name)]
V(g)$log2FC    <- all_nodes$log2FC[match(V(g)$name, all_nodes$name)]
V(g)$abundance <- all_nodes$abundance[match(V(g)$name, all_nodes$name)]
E(g)$edge_type <- all_edges$edge_type
E(g)$weight    <- all_edges$weight
 
cat("Network: ", vcount(g), "nodes |", ecount(g), "edges\n")
 
# --- 4D: NETWORK PLOT 1 — Full hierarchical network (Lipid → Class → Pathway) ---
