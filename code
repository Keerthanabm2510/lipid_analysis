nodes_co <- hm_both %>%
  transmute(
    name      = trimws(Lipid),
    Class     = trimws(Class),
    log2FC    = log2FC,
    abundance = (log2_T1 + log2_T2) / 2
  ) %>%
  distinct(name, .keep_all = TRUE) %>%
  as.data.frame()

rownames(nodes_co) <- NULL   # reset rownames to clean integers

# Build edges using integer indices — avoids all name-matching issues
class_groups <- split(seq_len(nrow(nodes_co)), nodes_co$Class)

edge_indices <- do.call(rbind, lapply(class_groups, function(idx) {
  if (length(idx) < 2) return(NULL)
  pairs <- combn(idx, 2)
  data.frame(from = pairs[1,], to = pairs[2,])
}))

# Build graph from integer indices then assign names
g_co <- graph_from_data_frame(
  d        = edge_indices,
  vertices = data.frame(name = seq_len(nrow(nodes_co))),
  directed = FALSE
)

# Assign node attributes manually
V(g_co)$name      <- nodes_co$name
V(g_co)$Class     <- nodes_co$Class
V(g_co)$log2FC    <- nodes_co$log2FC
V(g_co)$abundance <- nodes_co$abundance

g_co <- simplify(g_co)
g_co <- induced_subgraph(g_co, degree(g_co) > 0)

