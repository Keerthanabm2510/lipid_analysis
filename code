# =============================================================================
# HEATMAP FOR 2-SAMPLE LIPIDOMICS (T1 vs T2)
# =============================================================================
# WHY the previous heatmap was plain/uninformative:
#   - Z-score with only 2 samples always gives exactly +0.707 / -0.707
#     for every single lipid → all tiles become the same dark red / dark blue
#   - The lipid class colour bar wasn't rendering because annotation_colors
#     key name must exactly match the annotation data.frame column name
#
# SOLUTION:
#   1. Use log2(area) directly — shows real abundance differences between lipids
#   2. Keep only lipids detected in BOTH time points (no zeros) for heatmap
#      to avoid extreme fold changes from absence/presence patterns
#   3. Sort rows by lipid class so the class colour bar is visually meaningful
#   4. Add a second FC heatmap showing all lipids including unique ones
# =============================================================================

library(lipidr)
library(SummarizedExperiment)
library(readODS)
library(dplyr)
library(tidyr)
library(pheatmap)
library(RColorBrewer)
library(ggplot2)
library(ggrepel)

# --------------------------------------------------------------------------
# 1. LOAD & PREPARE DATA (same as before)
# --------------------------------------------------------------------------
file_path <- "/home/mahe/lipidomics/lipidomics_data.ods"

s1 <- read_ods(file_path, sheet = "1 sample")
s2 <- read_ods(file_path, sheet = "2 sample")
colnames(s1) <- c("Lipid", "intensity_T1", "area_T1")
colnames(s2) <- c("Lipid", "intensity_T2", "area_T2")

clean_lipid_name <- function(x) {
  x <- sub("\\+H$", "", x);  x <- sub("\\+Na$", "", x)
  x <- sub("-H$", "", x);    x <- sub("\\+NH4$", "", x)
  x <- sub("\\+HCOO$", "", x); x <- sub("\\+CHO.*$", "", x)
  x <- sub("\\+COOCH3.*$", "", x); x <- sub(":\\(s\\)$", "", x)
  trimws(x)
}
s1$Lipid <- clean_lipid_name(s1$Lipid)
s2$Lipid <- clean_lipid_name(s2$Lipid)

# Full join — all lipids across both time points
data_wide <- full_join(
  s1 %>% select(Lipid, T1 = area_T1),
  s2 %>% select(Lipid, T2 = area_T2),
  by = "Lipid"
) %>%
  group_by(Lipid) %>%
  summarise(across(everything(), ~ mean(.x, na.rm = TRUE)), .groups = "drop")

data_wide[is.na(data_wide)] <- 0

# Extract class from lipid name
data_wide <- data_wide %>%
    mutate(Class = stringr::str_extract(Lipid, "^[A-Za-z]+"))

# log2 transform
data_wide <- data_wide %>%
  mutate(log2_T1 = log2(T1 + 1),
         log2_T2 = log2(T2 + 1),
         log2FC  = log2_T2 - log2_T1,
         detected_in = case_when(
           T1 > 0 & T2 > 0 ~ "Both",
           T1 > 0 & T2 == 0 ~ "T1 only",
           T1 == 0 & T2 > 0 ~ "T2 only",
           TRUE ~ "Neither"
         ))

cat("Detection summary:\n")
print(table(data_wide$detected_in))

# --------------------------------------------------------------------------
# 2. HEATMAP A — Log2 Abundance (all detected lipids, sorted by class)
# --------------------------------------------------------------------------
# Using log2(area) directly — NOT z-score — so colour reflects real abundance
# This shows which lipids are high/low and how they differ between T1 and T2

hm_all <- data_wide %>%
  filter(detected_in %in% c("Both", "T1 only", "T2 only")) %>%
  arrange(Class, desc(log2_T1 + log2_T2))   # sort by class then by total signal

mat_log2 <- as.matrix(hm_all[, c("log2_T1", "log2_T2")])
rownames(mat_log2) <- hm_all$Lipid
colnames(mat_log2) <- c("T1", "T2")

# Annotation: lipid class (column name MUST match annotation_colors key exactly)
annot_row <- data.frame(
  Class = hm_all$Class,
  Detected = hm_all$detected_in,
  row.names = hm_all$Lipid
)

# Define class colours
classes <- sort(unique(hm_all$Class))
n_cls   <- length(classes)
cls_pal <- setNames(
  colorRampPalette(c(
    "#E41A1C","#377EB8","#4DAF4A","#984EA3","#FF7F00",
    "#A65628","#F781BF","#999999","#66C2A5","#FC8D62",
    "#8DA0CB","#E78AC3","#A6D854","#FFD92F","#B3B3B3",
    "#1B9E77","#D95F02","#7570B3","#E7298A","#66A61E"
  ))(n_cls),
  classes
)

det_colors <- c("Both" = "#2ca25f", "T1 only" = "#2b8cbe",
                "T2 only" = "#d7301f", "Neither" = "grey90")

annot_colors <- list(
  Class    = cls_pal,
  Detected = det_colors
)

# Column annotation
annot_col <- data.frame(
  TimePoint = c("T1", "T2"),
  row.names = c("T1", "T2")
)

png("heatmap_log2_abundance.png", width = 2000, height = 3200, res = 220)
pheatmap(
  mat_log2,
  color             = colorRampPalette(c("#f7fbff","#c6dbef","#6baed6","#2171b5","#08306b"))(100),
  annotation_row    = annot_row,
  annotation_col    = annot_col,
  annotation_colors = c(annot_colors,
                         list(TimePoint = c(T1 = "#2b8cbe", T2 = "#d7301f"))),
  cluster_cols      = FALSE,     # keep T1 → T2 order
  cluster_rows      = FALSE,     # keep class-sorted order (more interpretable)
  show_rownames     = TRUE,
  fontsize_row      = 5,
  fontsize_col      = 13,
  fontsize          = 10,
  border_color      = NA,
  gaps_row          = cumsum(table(hm_all$Class)),  # white gap between classes
  main              = "Lipidomics — MCF7 (T1 vs T2)\nlog2(peak area), sorted by lipid class"
)
dev.off()
cat("✓ Saved: heatmap_log2_abundance.png\n")

# --------------------------------------------------------------------------
# 3. HEATMAP B — log2 Fold Change (T2 vs T1), only lipids in BOTH samples
# --------------------------------------------------------------------------
# This is the most biologically informative view:
# one column per lipid, colour = direction and magnitude of change

hm_both <- data_wide %>%
  filter(detected_in == "Both") %>%
  arrange(Class, log2FC)

fc_mat <- matrix(hm_both$log2FC, ncol = 1)
rownames(fc_mat) <- hm_both$Lipid
colnames(fc_mat) <- "log2FC (T2/T1)"

annot_row_fc <- data.frame(
  Class = hm_both$Class,
  row.names = hm_both$Lipid
)

# Symmetric colour scale centred at 0
fc_max <- max(abs(hm_both$log2FC), na.rm = TRUE)
breaks_fc <- seq(-fc_max, fc_max, length.out = 101)

png("heatmap_foldchange.png", width = 1000, height = 3000, res = 220)
pheatmap(
  fc_mat,
  color             = colorRampPalette(rev(brewer.pal(11, "RdBu")))(100),
  breaks            = breaks_fc,
  annotation_row    = annot_row_fc,
  annotation_colors = list(Class = cls_pal[names(cls_pal) %in% hm_both$Class]),
  cluster_cols      = FALSE,
  cluster_rows      = FALSE,     # class-sorted, then by FC within class
  show_rownames     = TRUE,
  show_colnames     = TRUE,
  fontsize_row      = 5,
  fontsize_col      = 12,
  fontsize          = 10,
  border_color      = "white",
  gaps_row          = cumsum(table(hm_both$Class)),
  main              = "Fold Change Heatmap\nMCF7 T2 vs T1\n(lipids in both timepoints)"
)
dev.off()
cat("✓ Saved: heatmap_foldchange.png\n")

# --------------------------------------------------------------------------
# 4. HEATMAP C — Clustered heatmap (only lipids in BOTH, log2 values)
# --------------------------------------------------------------------------
# Clustering works properly here because lipids have different absolute
# abundances — this reveals co-regulated lipid groups

hm_both2 <- data_wide %>% filter(detected_in == "Both")
mat_both <- as.matrix(hm_both2[, c("log2_T1", "log2_T2")])
rownames(mat_both) <- hm_both2$Lipid
colnames(mat_both) <- c("T1", "T2")

annot_row_b <- data.frame(
  Class = hm_both2$Class,
  row.names = hm_both2$Lipid
)

png("heatmap_clustered_both.png", width = 1400, height = 2800, res = 220)
pheatmap(
  mat_both,
  color             = colorRampPalette(c("#fff7ec","#fdd49e","#fdbb84",
                                          "#fc8d59","#e34a33","#b30000"))(100),
  annotation_row    = annot_row_b,
  annotation_col    = data.frame(TimePoint = c("T1","T2"), row.names = c("T1","T2")),
  annotation_colors = c(
    list(Class     = cls_pal[names(cls_pal) %in% hm_both2$Class],
         TimePoint = c(T1 = "#2b8cbe", T2 = "#d7301f"))
  ),
  cluster_cols      = FALSE,
  cluster_rows      = TRUE,      # cluster lipids by abundance pattern
  cutree_rows       = 3,         # split into 3 clusters
  show_rownames     = TRUE,
  fontsize_row      = 5.5,
  fontsize_col      = 13,
  border_color      = NA,
  main              = "Clustered Heatmap — Lipids in Both Timepoints\nlog2(peak area)"
)
dev.off()
cat("✓ Saved: heatmap_clustered_both.png\n")

# --------------------------------------------------------------------------
# 5. BONUS: Lipid class summary bar plot (mean log2FC per class)
# --------------------------------------------------------------------------
class_fc <- data_wide %>%
  filter(detected_in == "Both") %>%
  group_by(Class) %>%
  summarise(
    n          = n(),
    mean_log2FC = mean(log2FC),
    se          = sd(log2FC) / sqrt(n()),
    up          = sum(log2FC > 1),
    down        = sum(log2FC < -1),
    .groups = "drop"
  ) %>%
  arrange(mean_log2FC)

p_bar <- ggplot(class_fc, aes(x = reorder(Class, mean_log2FC),
                               y = mean_log2FC, fill = mean_log2FC)) +
  geom_col(color = "white", width = 0.7) +
  geom_errorbar(aes(ymin = mean_log2FC - se, ymax = mean_log2FC + se),
                width = 0.3, color = "grey30") +
  geom_hline(yintercept = 0, linewidth = 0.6) +
  geom_text(aes(label = paste0("n=", n)),
            hjust = ifelse(class_fc$mean_log2FC >= 0, -0.2, 1.2),
            size = 3.2, color = "grey20") +
  scale_fill_gradient2(low = "#2b8cbe", mid = "grey90", high = "#d7301f",
                       midpoint = 0, guide = "none") +
  coord_flip() +
  labs(title    = "Mean log2 Fold Change per Lipid Class (T2 vs T1)",
       subtitle = "Error bars = ±SE | n = lipids detected in both timepoints",
       x = NULL, y = "Mean log2FC (T2/T1)") +
  theme_bw(base_size = 13) +
  theme(panel.grid.major.y = element_blank())
ggsave("barplot_class_FC.png", p_bar, width = 9, height = 6, dpi = 200)
cat("✓ Saved: barplot_class_FC.png\n")

cat("\n=== All heatmaps saved ===\n")
cat("heatmap_log2_abundance.png  — all lipids, log2 area, class-sorted\n")
cat("heatmap_foldchange.png      — lipids in both, single-column FC heatmap\n")
cat("heatmap_clustered_both.png  — lipids in both, clustered by abundance\n")
cat("barplot_class_FC.png        — mean FC per class summary\n")
