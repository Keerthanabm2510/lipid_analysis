}
 
# =============================================================================
# BLOCK 1: KEGG PATHWAY MAPPING
# =============================================================================
# KEGG does not have individual lipid species IDs (like genes have Entrez IDs)
# so we map at the LIPID CLASS level — which is the standard approach for
# lipidomics KEGG analysis (used in published MCF7 lipidomics studies)
# Each class maps to a specific KEGG lipid metabolism pathway
# =============================================================================
 
kegg_map <- data.frame(
  Class = c(
    # Glycerophospholipids — hsa00564
    "PC","LPC","LPCO","LPCP",
    "PE","LPE",
    "PS","LPS",
    "PI","LPI",
    "PG","PGO","PGP",
    "PA",
    # Sphingolipids — hsa00600
    "SM","Cer","SPH","HexCer","LacCer",
    # Glycerolipids — hsa00561
    "TG","DG","MG",
    # Fatty acids — hsa01212
    "FA","FAHFA","NA",
    # Fatty acid degradation — hsa00071
    "AcCa",
    # Ether lipids — hsa00565
    "PC O","PE O","LPC O","LPE O"
  ),
  KEGG_id = c(
    rep("hsa00564", 14),
    rep("hsa00600", 5),
    rep("hsa00561", 3),
    rep("hsa01212", 3),
    "hsa00071",
    rep("hsa00565", 4)
  ),
  KEGG_pathway = c(
    rep("Glycerophospholipid metabolism", 14),
    rep("Sphingolipid metabolism", 5),
    rep("Glycerolipid metabolism", 3),
    rep("Fatty acid metabolism", 3),
    "Fatty acid degradation",
    rep("Ether lipid metabolism", 4)
  ),
  stringsAsFactors = FALSE
)
 
# --- Merge your lipids with KEGG map ---
fc_kegg <- data_wide %>%
  left_join(kegg_map, by = "Class")
 
# How many lipids mapped?
cat("\nKEGG mapping summary:\n")
cat("  Mapped:   ", sum(!is.na(fc_kegg$KEGG_pathway)), "lipids\n")
cat("  Unmapped: ", sum( is.na(fc_kegg$KEGG_pathway)), "lipids\n")
cat("  Unmapped classes:", paste(unique(fc_kegg$Class[is.na(fc_kegg$KEGG_pathway)]), collapse=", "), "\n\n")
 
fc_kegg_mapped <- fc_kegg %>% filter(!is.na(KEGG_pathway))
 
# =============================================================================
# BLOCK 2: KEGG PATHWAY SUMMARY TABLE
# =============================================================================
 
pathway_summary <- fc_kegg_mapped %>%
  group_by(KEGG_pathway, KEGG_id) %>%
  summarise(
    n_total      = n(),
    n_both       = sum(detected_in == "Both"),
    n_T1_only    = sum(detected_in == "T1 only"),
    n_T2_only    = sum(detected_in == "T2 only"),
    mean_log2FC  = round(mean(log2FC[detected_in == "Both"], na.rm = TRUE), 3),
    up_in_T2     = sum(log2FC > 1,  na.rm = TRUE),
    down_in_T2   = sum(log2FC < -1, na.rm = TRUE),
    unchanged    = sum(abs(log2FC) <= 1, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(desc(abs(mean_log2FC)))
 
cat("KEGG Pathway Summary:\n")
print(pathway_summary)
 
# =============================================================================
# BLOCK 3: KEGG VISUALISATIONS
# =============================================================================
 
# --- 3A: Bubble plot — main KEGG plot ---
p_bubble <- ggplot(pathway_summary,
                   aes(x    = mean_log2FC,
                       y    = reorder(KEGG_pathway, mean_log2FC),
                       size = n_total,
                       fill = mean_log2FC)) +
  geom_point(shape = 21, alpha = 0.9, color = "grey20") +
  geom_vline(xintercept = 0, linetype = "dashed", color = "grey40") +
  geom_vline(xintercept = c(-1, 1), linetype = "dotted", color = "grey60") +
  geom_text(aes(label = paste0(up_in_T2, "↑  ", down_in_T2, "↓")),
            hjust = -0.25, size = 3.8, fontface = "bold") +
  scale_fill_gradient2(low  = "#4575b4",
                       mid  = "grey95",
                       high = "#d73027",
                       midpoint = 0,
                       name = "Mean\nlog2FC") +
  scale_size_continuous(range = c(5, 20), name = "Total\nlipids") +
  scale_x_continuous(expand = expansion(mult = c(0.15, 0.35))) +
  labs(
    title    = "KEGG Lipid Pathway Activity — MCF7 (T2 vs T1)",
    subtitle = "Bubble size = total lipids in pathway | Color = direction of change\nNumbers = lipids with |log2FC| > 1  (↑ up in T2, ↓ down in T2)",
    x        = "Mean log2 Fold Change (T2/T1)",
    y        = NULL
  ) +
  theme_bw(base_size = 13) +
  theme(
    axis.text.y      = element_text(size = 12, face = "bold"),
    plot.title       = element_text(face = "bold"),
    legend.position  = "right",
    panel.grid.major.y = element_line(color = "grey90")
  )
 
ggsave("KEGG_bubble_plot.png", p_bubble, width = 11, height = 6, dpi = 220)
cat("✓ Saved: KEGG_bubble_plot.png\n")
 
# --- 3B: Stacked bar — up/down/T1 only/T2 only per pathway ---
bar_df <- fc_kegg_mapped %>%
  mutate(category = case_when(
    detected_in == "T2 only" ~ "New in T2",
    detected_in == "T1 only" ~ "Lost in T2",
    log2FC >  1              ~ "Up in T2 (>2×)",
    log2FC < -1              ~ "Down in T2 (>2×)",
    TRUE                     ~ "Unchanged"
  )) %>%
  count(KEGG_pathway, category)
 
cat_colors <- c(
  "Up in T2 (>2×)"   = "#d73027",
  "New in T2"        = "#fc8d59",
  "Unchanged"        = "grey75",
  "Down in T2 (>2×)" = "#4575b4",
  "Lost in T2"       = "#91bfdb"
)
 
p_bar <- ggplot(bar_df,
                aes(x    = reorder(KEGG_pathway, n, sum),
                    y    = n,
                    fill = category)) +
  geom_col(position = "stack", color = "white", width = 0.65) +
  geom_text(aes(label = n),
            position = position_stack(vjust = 0.5),
            size = 3.2, color = "white", fontface = "bold") +
  scale_fill_manual(values = cat_colors, name = NULL) +
  coord_flip() +
  labs(
    title    = "Lipid Changes per KEGG Pathway — MCF7 (T2 vs T1)",
    subtitle = "New/Lost = detected in only one timepoint",
    x        = NULL,
    y        = "Number of lipids"
  ) +
  theme_bw(base_size = 13) +
  theme(
    axis.text.y     = element_text(size = 11, face = "bold"),
    legend.position = "bottom",
    plot.title      = element_text(face = "bold")
  )
 
ggsave("KEGG_stacked_bar.png", p_bar, width = 11, height = 6, dpi = 220)
cat("✓ Saved: KEGG_stacked_bar.png\n")
 
# --- 3C: Dot plot per lipid class within each pathway ---
class_fc_summary <- fc_kegg_mapped %>%
  filter(detected_in == "Both") %>%
  group_by(KEGG_pathway, Class) %>%
  summarise(
    n           = n(),
    mean_log2FC = mean(log2FC, na.rm = TRUE),
    .groups = "drop"
  )
 
p_dot <- ggplot(class_fc_summary,
                aes(x = mean_log2FC, y = Class, size = n, color = mean_log2FC)) +
  geom_point(alpha = 0.9) +
  geom_vline(xintercept = 0, linetype = "dashed") +
