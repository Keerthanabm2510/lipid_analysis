library(igraph)
library(ggraph)
library(writexl)
 
setwd("/home/mahe/lipidomics")
 
# =============================================================================
# BLOCK 0: DATA — skip this if data_wide already exists from heatmap script
# =============================================================================
 
if (!exists("data_wide")) {
  
